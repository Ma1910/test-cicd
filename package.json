{
  "name": "ci-cd-quicktest",
  "version": "1.0.0",
  "description": "Dự án mẫu siêu nhẹ để kiểm thử toàn diện quy trình CI/CD GitHub Actions & Docker",
  "main": "dist/index.js",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "lint": "tsc --noEmit",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:smoke": "vitest run -t health",
    "docker:build": "docker build -t test-cicd .",
    "docker:dev": "docker compose up -d",
    "docker:prod": "docker compose -f docker-compose.prod.yml up -d",
    "docker:down": "docker compose down",
    "sync": "git pull origin main",
    "check:team": "node scripts/check-updates.js",
    "cicd:web": "node scripts/open-cicd.js"
  },
  "dependencies": {
    "express": "^4.22.2"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^22.13.9",
    "@types/supertest": "^6.0.2",
    "@vitest/coverage-v8": "^3.2.7",
    "supertest": "^7.0.0",
    "tsx": "^4.19.3",
    "typescript": "^5.7.3",
    "vitest": "^3.0.7"
  },
  "overrides": {
    "qs": "^6.16.0"
  }
}
