# ==============================================================================
# ENVIRONMENT VARIABLES TEMPLATE (Clean & Production-Ready)
# ==============================================================================
# NOTE: Do NOT commit actual secrets or passwords to Git.
# Copy this file to .env.production on your deployment server or configure in GitHub Secrets.

# Node Runtime Configuration
NODE_ENV=production
PORT=3000

# Application Security
# Generate a strong 256-bit key in production: openssl rand -hex 32
JWT_SECRET=your_super_secret_jwt_key_minimum_32_characters

# Rate Limiting
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=100

# Docker Registry Image Tag (Used by Docker Compose)
DOCKER_IMAGE=ghcr.io/ma1910/ci-cd-quicktest:latest
